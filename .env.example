VOICE_ENV=development
VOICE_HOST=0.0.0.0
VOICE_PORT=8080
VOICE_API_KEY=
VOICE_LOG_LEVEL=INFO
VOICE_DATA_DIR=./data
VOICE_MODEL_DIR=./models
VOICE_LANGUAGE_CONFIG=./config/languages.yaml

VOICE_ASR_ENGINE=faster_whisper
VOICE_ASR_MODEL=large-v3
VOICE_ASR_DEVICE=auto
VOICE_ASR_COMPUTE_TYPE=default
VOICE_ASR_BEAM_SIZE=5
VOICE_ASR_VAD=true

VOICE_LLM_ENABLED=true
VOICE_LLM_BASE_URL=http://127.0.0.1:8001/v1
VOICE_LLM_MODEL=local-model
VOICE_LLM_API_KEY=local
VOICE_LLM_TIMEOUT_SECONDS=60
VOICE_LLM_MAX_TOKENS=512
VOICE_LLM_TEMPERATURE=0.35

VOICE_DEFAULT_TTS_ENGINE=chatterbox
VOICE_CHATTERBOX_DEVICE=auto
VOICE_CHATTERBOX_MODEL=v3
VOICE_NEMO_DEVICE=auto

VOICE_MAX_UPLOAD_MB=30
VOICE_MAX_WS_AUDIO_SECONDS=90
VOICE_DEFAULT_SAMPLE_RATE=16000
